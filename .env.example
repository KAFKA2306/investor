# Investor environment configuration example
# Copy this file to .env and replace every placeholder locally.
# Never commit real credentials.

NODE_ENV=development
LOG_LEVEL=INFO

# Provider credentials
JQUANTS_API_KEY=replace_with_jquants_api_key
JQUANTS_ID_TOKEN=
EDINET_API_KEY=replace_with_edinet_api_key
ESTAT_APP_ID=replace_with_estat_app_id
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-5-nano
OPENAI_BASE_URL=https://api.openai.com/v1
HF_KEY=

# Canonical PostgreSQL database
CANONICAL_DB_URL=postgresql://investor:change_me@localhost:5432/investor
CANONICAL_DB_HOST=localhost
CANONICAL_DB_PORT=5432
CANONICAL_DB_NAME=investor
CANONICAL_DB_USER=investor
CANONICAL_DB_PASSWORD=change_me

# Company intelligence stack
COMPANY_DB_PORT=5433
COMPANY_API_PORT=8080
COMPANY_RAW_DIR=./data/company-intelligence/raw

# Runtime and experiment options
VERIFY_TARGETS=jquants,kabucom,edinet,estat
UQTL_INPUT_CHANNEL=task
UQTL_NL_INPUT=
UQTL_NL_INPUT_FILE=
UQTL_EXPERIMENT_ID=exp-alpha-search-default

# Polymarket integration (optional)
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
